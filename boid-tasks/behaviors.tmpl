executor:
  name: executor
  kits:
    - github.com/novshi-tech/boid-kits/github-pr-verification
    - github.com/novshi-tech/boid-kits/github-auto-merge
  default_instruction:
    type: execution
    consumer: {{.Consumer}}
    message: |
      /boid-executor skill に従って task.yaml の title と
      description に記述された内容を実装せよ。 実装が完了したら
      プロジェクト側のリリーススキル (例: /dev-pr-flow) があれば
      それを呼ぶ。 無ければローカルで commit + push して終了する。
supervisor:
  name: supervisor
  kits:
    - github.com/novshi-tech/boid-kits/boid-tasks
  default_instruction:
    type: execution
    consumer: {{.Consumer}}
    interactive: true
    message: |
      /boid-supervisor skill に従って子タスクを作成して監視せよ。
